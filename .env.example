APP_NAME=Nerius API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
DB_ECHO=false

# --- Local / TCP MySQL (Aiven, dev) -----------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
# MYSQL_ROOT_PASSWORD=toor
# MYSQL_DATABASE=iot
# DB_SSL_CA=/app/ca.pem  # only for Aiven/external MySQL with TLS

# --- Cloud SQL via Unix socket on Cloud Run ---------------------------------
# When INSTANCE_CONNECTION_NAME is set, the app ignores MYSQL_HOST/PORT and
# connects to /cloudsql/<INSTANCE_CONNECTION_NAME> (mounted by Cloud Run when
# --add-cloudsql-instances is passed). MYSQL_USER, MYSQL_ROOT_PASSWORD and
# MYSQL_DATABASE are still required.
# INSTANCE_CONNECTION_NAME=my-project:us-central1:nerius-db
# CLOUD_SQL_SOCKET_DIR=/cloudsql
